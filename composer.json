{
    "name": "halo123450/AdapterMan",
    "type": "library",
    "keywords": [
        "workerman",
        "php",
        "event"
    ],
    "license": "MIT",
    "description": "Use any framework and application with Workerman.",
    "authors": [
        {
            "name": "halo123450",
            "email": "tan840027@qq.com",
            "homepage": "https://s-3.cn",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/halo123450/AdapterMan/issues",
        "source": "https://github.com/halo123450/AdapterMan"
    },
    "require": {
        "php": "^8.1",
        "workerman/workerman": "^4.1|^5.1"
    },
    "require-dev": {
        "php": "^8.2",
        "ext-curl": "*",
        "pestphp/pest": "^2.36 || ^3 || ^4",
        "mockery/mockery": "^1.6",
        "guzzlehttp/guzzle": "^7.0"
    },
    "bin": ["adapterman"],
    "suggest": {
        "ext-event": "For better performance. "
    },
    "autoload": {
        "psr-4": {
            "Halo123450\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
